# Copy to group_vars/gtb.yml (gitignored) and fill in. Encrypt the secrets
# section with ansible-vault:  ansible-vault encrypt_string '<value>' --name cron_secret
---
# Human admin: your key(s), passwordless sudo, what Ansible connects as.
admin_user: admin
admin_ssh_public_keys:
  - "ssh-ed25519 AAAA... you@laptop"

# CI-only account: docker group, NO sudo. Exactly the CI key (exclusive) — its
# private half goes in the repo's VPS_SSH_KEY Actions secret.
deploy_user: deploy
deploy_ssh_public_keys:
  - "ssh-ed25519 AAAA... github-actions-deploy"

api_domain: api.yourdomain.com
certbot_email: you@yourdomain.com

# Optional dead-man's switch for the daily cron: a healthchecks.io (or similar)
# ping URL curled after each successful run. Leave empty to disable.
healthchecks_ping_url: ""

# GHCR pull credentials: a GitHub PAT (classic) with read:packages, or a
# fine-grained token. Used once for `docker login` on the VPS.
ghcr_username: your-github-username
ghcr_token: "{{ vault_ghcr_token }}"
gtb_image: ghcr.io/your-github-username/gtb/gtb-api

# Runtime environment for the API container (templated into /opt/gtb/gtb-api.env).
# Same keys as apps/api/.env — see DEPLOYMENT.md §2.3. Vault the secrets.
gtb_api_env:
  DATABASE_URL: "{{ vault_database_url }}"
  DIRECT_URL: "{{ vault_direct_url }}"
  SUPABASE_URL: https://<ref>.supabase.co
  SUPABASE_ANON_KEY: "{{ vault_supabase_anon_key }}"
  SUPABASE_SERVICE_ROLE_KEY: "{{ vault_supabase_service_role_key }}"
  SUPABASE_JWT_SECRET: "{{ vault_supabase_jwt_secret }}"
  # Optional until launch: empty = deterministic stub scorer (never ship ads on it).
  GEMINI_API_KEY: "{{ vault_gemini_api_key | default('') }}"
  MAILGUN_SMTP_HOST: smtp.mailgun.org
  MAILGUN_SMTP_PORT: "587"
  MAILGUN_SMTP_USER: postmaster@yourdomain.mailgun.org
  MAILGUN_SMTP_PASSWORD: "{{ vault_mailgun_password }}"
  MAIL_FROM: "GTB OS <no-reply@yourdomain.com>"
  WEB_ORIGIN: https://app.yourdomain.com
  WEB_PUBLIC_URL: https://app.yourdomain.com
  API_PUBLIC_URL: "https://{{ api_domain }}"
  CRON_SECRET: "{{ vault_cron_secret }}"
  # Optional: error tracking. Empty = Sentry disabled.
  SENTRY_DSN: ""
  # Optional: WhatsApp channel for funnel drips ("none" until a provider adapter
  # is configured in apps/api/src/lib/channels.ts).
  WHATSAPP_PROVIDER: none
