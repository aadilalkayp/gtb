# Fires the GTB OS hourly jobs (12-hour unread chat emails).
# Managed by Ansible; triggered by gtb-cron-hourly.timer.
[Unit]
Description=GTB OS hourly cron trigger
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Hits the container directly on loopback — no dependency on nginx/TLS/DNS.
ExecStart=/usr/bin/curl --silent --show-error --fail --max-time 120 \
  -H "x-cron-secret: {{ gtb_api_env.CRON_SECRET }}" \
  http://127.0.0.1:3001/api/cron/hourly
