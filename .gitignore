# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Generated (ZenStack / Prisma)
packages/db/src/generated/
packages/db/.zenstack/

# Env
.env
.env.local
.env.*.local

# Local Supabase (CLI runtime state — never commit)
supabase/.temp/
supabase/.branches/
**/supabase/.temp/
**/supabase/.branches/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
coverage/
*.pem

# Deploy secrets (examples are committed instead)
deploy/ansible/inventory.ini
deploy/ansible/group_vars/gtb.yml
.vault-pass

# Eval harness (apps/api/evals): response cache, run reports, and golden
# photos (photos of real people are never committed — see evals/golden/README.md)
apps/api/evals/.cache/
apps/api/evals/reports/
apps/api/evals/golden/*
!apps/api/evals/golden/README.md
!apps/api/evals/golden/manifest.json
