model StylingLibraryItem {
  id          String             @id() @default(uuid())
  kind        StylingLibraryKind
  title       String
  category    String?
  priceRange  String?
  url         String?
  notes       String?
  isActive    Boolean            @default(true)
  createdById String
  createdBy   User               @relation("StylingLibraryAuthor", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt()

  @@index([kind, isActive])
}

model Conversation {
  id                 String             @id() @default(uuid())
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  kind               ConversationKind
  lastMessageAt      DateTime?
  /// Who spoke last, so "client waiting for a reply" is a cheap query.
  lastSenderIsClient Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt()
  messages           Message[]
  reads              ConversationRead[]

  @@unique([clientId, kind])
  @@index([kind, lastMessageAt])
}

model Message {
  id             String       @id() @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  body           String
  /// Optional chat_attachment Document (image or PDF).
  documentId     String?      @unique()
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  /// Set once the 12-hour unread email has been attempted (sent or not).
  emailAlertedAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt, emailAlertedAt])
}

/// How far each participant has read. One row per conversation per user.
model ConversationRead {
  id             String       @id() @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConversationReader", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime

  @@unique([conversationId, userId])
}

model Document {
  id             String         @id() @default(uuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  type           DocumentType
  fileName       String
  fileUrl        String
  fileSize       Int
  sessionId      String?
  session        Session?       @relation(fields: [sessionId], references: [id])
  /// Set on nutrition_plan uploads: the fitness plan the diet PDF belongs to.
  /// One per plan; uploading a new one replaces the previous (upload route).
  fitnessPlanId  String?
  fitnessPlan    FitnessPlan?   @relation(fields: [fitnessPlanId], references: [id], onDelete: SetNull)
  uploadedById   String
  uploadedBy     User           @relation("DocUploader", fields: [uploadedById], references: [id])
  /// Plan PDFs (skincare/fitness/nutrition) are versioned per client and type
  /// (nutrition: per fitness plan). Other documents stay version null, active.
  version        Int?
  status         DocumentStatus @default(active)
  description    String?
  createdAt      DateTime       @default(now())
  paymentProof   Payment?       @relation("PaymentProof")
  expenseReceipt Expense?       @relation("ExpenseReceipt")
  stylingPhoto   StylingPhoto?
  chatMessage    Message?
  skinPhoto      SkinPhoto?

  @@index([clientId])
  @@index([type])
  @@index([sessionId])
  @@index([fitnessPlanId])
  @@index([clientId, type, version])
}

/// Per-session fee for a consultant, optionally specific to a service type.
model ConsultantRate {
  id          String      @id() @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType ServiceType
  amount      Int
  createdAt   DateTime    @default(now())

  @@unique([userId, serviceType])
}

model ExpenseCategory {
  id        String    @id() @default(uuid())
  name      String    @unique()
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id                String          @id() @default(uuid())
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  title             String
  amount            Int
  date              DateTime
  paidTo            String?
  submittedById     String
  submittedBy       User            @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  clientId          String?
  client            Client?         @relation(fields: [clientId], references: [id])
  payeeId           String?
  payee             User?           @relation("ExpensePayee", fields: [payeeId], references: [id])
  sessionId         String?
  status            ExpenseStatus   @default(submitted)
  approvedById      String?
  approvedBy        User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  receiptDocumentId String?         @unique()
  receiptDocument   Document?       @relation("ExpenseReceipt", fields: [receiptDocumentId], references: [id])
  notes             String?
  rejectionReason   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt()

  @@index([status])
  @@index([date])
  @@index([submittedById])
  @@index([payeeId])
  @@index([clientId])
  @@index([categoryId])
}

model ContentItem {
  id          String          @id() @default(uuid())
  title       String
  contentType ContentType
  campaign    Campaign
  platform    ContentPlatform
  ownerId     String?
  owner       User?           @relation("ContentOwner", fields: [ownerId], references: [id])
  deadline    DateTime?
  status      ContentStage    @default(planned)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt()

  @@index([status])
}

model Task {
  id           String       @id() @default(uuid())
  title        String
  description  String?
  assignedToId String
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User         @relation("TaskCreator", fields: [assignedById], references: [id])
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  dueDate      DateTime?
  priority     TaskPriority @default(medium)
  status       TaskStatus   @default(pending)
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  @@index([assignedToId, status])
  @@index([clientId])
  @@index([dueDate])
}

/// One AI readiness scan: a selfie scored by the vision pipeline. Created and
/// scored exclusively by the /api/scan/* server routes (the public funnel runs
/// pre-auth, and score fields must never be client-writable) — the gateway
/// exposes no create/update below admin. clientId is null while a scan is
/// anonymous (pre email capture); unclaimed scans are purged by the daily job.
model Scan {
  id              String              @id() @default(uuid())
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Storage object path in the private scan-photos bucket (never a public URL).
  photoPath       String
  /// Capture channel — "web" today; "whatsapp" / "telegram" / "app" later. The
  /// scoring pipeline is channel-agnostic so new capture surfaces just tag this.
  source          String              @default("web")
  /// Wedding date captured with the scan (copied to the Client at claim time).
  weddingDate     DateTime
  type            ClientType          @default(groom)
  status          ScanStatus          @default(pending)
  modelVersion    String?
  failureReason   String?
  skinScore       Int?
  hairScore       Int?
  beardScore      Int?
  styleScore      Int?
  readinessScore  Int?
  /// JSON array of { area, weight } — e.g. [{"area":"pigmentation","weight":70}].
  focusAreas      Json?
  /// Positive observations shown to the user ("Strong jawline definition").
  highlights      String[]
  /// Improvement pointers feeding the roadmap ("Hydration routine, twice daily").
  suggestions     String[]
  /// Attribute-level appearance metrics, JSON array of { key, label, score }
  /// (tone evenness, clarity, hydration look, under-eye, hair density…). Neutral
  /// appearance names only — never condition names.
  attributes      Json?
  selfReport      Json?
  fitnessScore    Int?
  confidenceScore Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt()
  photos          ScanPhoto[]
  outfitChecks    OutfitCheck[]
  lookPreviews    LookPreview[]
  coachThreads    CoachConversation[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

/// Additional angles for a scan (front is Scan.photoPath). A full-body photo
/// unlocks the Style score; side angles sharpen hair/beard scoring. Same
/// bucket, same retention, same read policy as the parent scan.
model ScanPhoto {
  id        String         @id() @default(uuid())
  scanId    String
  scan      Scan           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  angle     ScanPhotoAngle
  /// Storage object path in the private scan-photos bucket.
  path      String
  createdAt DateTime       @default(now())

  @@index([scanId])
}

/// A self-serve prep task on the client's readiness roadmap — weekly focus items
/// generated from scan results plus fixed checklist milestones (suit trial,
/// ring, packing…), all offset from the wedding date. Distinct from Session
/// (consultant-delivered); the portal renders both on one timeline.
model RoadmapItem {
  id          String          @id() @default(uuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  kind        RoadmapItemKind
  /// skin | hair | beard | style | fitness | logistics
  category    String
  title       String
  description String?
  dueDate     DateTime
  /// 1-based week index for weekly_focus items (null for checklist milestones).
  weekNumber  Int?
  isDone      Boolean         @default(false)
  doneAt      DateTime?
  createdAt   DateTime        @default(now())

  @@index([clientId, dueDate])
}

/// Every funnel message sent to a client (scan report, drips, rescan nudges),
/// one row per (client, template). Doubles as the idempotency key for the
/// daily drip job and as the staff-visible send history. Written only by the
/// server's channel layer (apps/api/src/lib/channels.ts).
model OutboundMessage {
  id         String         @id() @default(uuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  channel    MessageChannel
  /// Template key, e.g. "scan_report", "drip_day3_focus" (see funnelTemplates.ts).
  template   String
  status     MessageStatus
  /// Provider message id when available (Mailgun / WhatsApp), for support lookups.
  providerId String?
  error      String?
  createdAt  DateTime       @default(now())

  @@unique([clientId, template, channel])
  @@index([clientId, createdAt])
}

/// One outfit check: up to three garment photos judged against the person's
/// skin tone (from their scan's front selfie). Anchored to a scan so funnel
/// leads can use it from their report page (scanId = bearer secret); enrolled
/// clients see history in the portal. Photos live in the scan-photos bucket.
model OutfitCheck {
  id           String   @id() @default(uuid())
  scanId       String
  scan         Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Storage paths of the garment photos, in upload order.
  photoPaths   String[]
  modelVersion String?
  /// Per-garment results: [{ index, verdict, score, colorNote, fitNote, suggestion }]
  results      Json?
  /// Palette guidance: { tryColors: string[], avoidColors: string[], summary }
  palette      Json?
  createdAt    DateTime @default(now())

  @@index([scanId])
  @@index([clientId, createdAt])
}

/// A generated hairstyle / beard preview rendered onto the person's own
/// selfie. Costs real money per render, so creation is server-only and capped
/// per scan per day and globally per month (see looks.ts).
model LookPreview {
  id           String     @id() @default(uuid())
  scanId       String
  scan         Scan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  kind         LookKind
  /// Catalog key from packages/shared/src/looks.ts (e.g. "textured_crop").
  styleKey     String
  status       LookStatus @default(pending)
  /// Storage path of the generated image (scan-photos bucket) once ready.
  path         String?
  modelVersion String?
  error        String?
  createdAt    DateTime   @default(now())

  @@index([scanId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])
}

/// The coach's knowledge base: GTB's methodology as staff-editable articles.
/// The coach answers ONLY from active articles plus the user's own scan
/// context. Ships empty (a starter set can be created from Settings) — GTB
/// owns the content.
model CoachArticle {
  id        String        @id() @default(uuid())
  title     String
  category  CoachCategory
  /// Markdown body. Keep articles focused: one topic, one answerable question.
  content   String
  tags      String[]
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt()

  @@index([category, isActive])
}

/// A coach chat thread. Anchored to a scan (funnel leads, bearer secret) and,
/// once known, the client. Messages are server-written.
model CoachConversation {
  id        String         @id() @default(uuid())
  scanId    String?
  scan      Scan?          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt()
  messages  CoachMessage[]

  @@index([clientId, updatedAt])
  @@index([scanId])
}

model CoachMessage {
  id             String            @id() @default(uuid())
  conversationId String
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           CoachRole
  content        String
  /// Titles of the knowledge articles the answer drew on (assistant turns).
  sources        String[]
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

/// A client's fitness program: a fixed-length day-by-day journey (default 30
/// days) owned by the assigned fitness trainer. Health status ("on track",
/// "needs follow-up") is DERIVED from the days — never stored (see
/// @gtb/shared fitness.ts), the same principle as payment pace.
model FitnessPlan {
  id             String              @id() @default(uuid())
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  trainerId      String?
  trainer        User?               @relation("PlanTrainer", fields: [trainerId], references: [id])
  title          String
  /// Free-text goal shown on both portals, e.g. "Fat loss & better stamina".
  goal           String
  /// FITNESS_TEMPLATES key the days were seeded from (null for custom plans).
  templateKey    String?
  startDate      DateTime
  durationDays   Int                 @default(30)
  status         FitnessPlanStatus   @default(active)
  startWeightKg  Float?
  targetWeightKg Float?
  /// Optional one-line summary shown as the portal "Nutrition note"; the full
  /// diet plan is the nutrition_plan Document in dietPlans.
  dietNotes      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt()
  days           FitnessWorkoutDay[]
  checkIns       FitnessCheckIn[]
  dietPlans      Document[]

  @@index([clientId, status])
  @@index([status, startDate])
}

/// One day of a fitness plan. dayIndex is the 1-based journey day; date is the
/// concrete IST day it falls on (denormalized for querying and the cron nudge).
model FitnessWorkoutDay {
  id          String            @id() @default(uuid())
  planId      String
  plan        FitnessPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayIndex    Int
  date        DateTime
  title       String
  isRestDay   Boolean           @default(false)
  completedAt DateTime?
  exercises   FitnessExercise[]

  @@unique([planId, dayIndex])
  @@index([date])
}

/// An exercise prescription within a workout day. Clients tick exercises off
/// (completedAt); the prescription itself is trainer-owned.
model FitnessExercise {
  id          String            @id() @default(uuid())
  dayId       String
  day         FitnessWorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order       Int               @default(0)
  name        String
  sets        Int?
  reps        Int?
  durationSec Int?
  /// e.g. "Bodyweight", "Dumbbell", "Machine", "Cardio".
  equipment   String?
  notes       String?
  completedAt DateTime?

  @@index([dayId])
}

/// Weight time series (the Assessment's weightKg stays the one-time onboarding
/// snapshot; this is the tracked log behind the progress chart).
model WeightLog {
  id           String   @id() @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  date         DateTime
  weightKg     Float
  note         String?
  recordedById String
  recordedBy   User     @relation("WeightRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([clientId, date])
}

/// Body measurements time series (all cm; every field optional so partial
/// check-ins are fine).
model BodyMeasurement {
  id           String   @id() @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  date         DateTime
  chestCm      Float?
  waistCm      Float?
  hipsCm       Float?
  bicepCm      Float?
  thighCm      Float?
  note         String?
  recordedById String
  recordedBy   User     @relation("MeasurementRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([clientId, date])
}

/// Client-submitted weekly pulse on a plan (distinct from FollowUp's
/// weekly_checkin, which is a staff CRO call). One per plan-week.
model FitnessCheckIn {
  id             String      @id() @default(uuid())
  planId         String
  plan           FitnessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// 1-based week of the plan (ceil(dayNumber / 7)).
  weekNumber     Int
  /// 1–5 self-rated energy/effort.
  energyLevel    Int?
  weightKg       Float?
  note           String?
  /// The trainer's reply — trainer/admin-writable only.
  trainerComment String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt()

  @@unique([planId, weekNumber])
}

/// A trainer's dated note on a client. visibleToClient notes render in the
/// portal ("Trainer Notes"); internal ones stay staff-side (like
/// consultation_notes documents).
model TrainerNote {
  id              String   @id() @default(uuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  authorId        String
  author          User     @relation("TrainerNoteAuthor", fields: [authorId], references: [id])
  content         String
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([clientId, createdAt])
}

model Notification {
  id        String   @id() @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  linkPath  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ActivityLog {
  id            String         @id() @default(uuid())
  entityType    String
  entityId      String
  action        ActivityAction
  performedById String?
  performedBy   User?          @relation("ActivityActor", fields: [performedById], references: [id])
  summary       String?
  changes       Json?
  verb          String?
  kind          ActivityKind   @default(change)
  module        String?
  actorRole     Role?
  source        String?
  requestId     String?
  clientId      String?
  meta          Json?
  createdAt     DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([performedById, createdAt])
  @@index([clientId, createdAt])
  @@index([requestId])
}

/// Team Pulse presence: one row per staff member per IST work day (4 am
/// boundary). Kept permanently; server-written, never exposed on the gateway.
model StaffDay {
  id            String   @id() @default(uuid())
  userId        String
  user          User     @relation("StaffDays", fields: [userId], references: [id], onDelete: Cascade)
  day           DateTime @db.Date()
  firstSeenAt   DateTime
  lastSeenAt    DateTime
  activeMinutes Int      @default(0)
  changeCount   Int      @default(0)
  viewCount     Int      @default(0)

  @@unique([userId, day])
  @@index([day])
}

/// Team Pulse presence: one row per staff member per minute with real input.
/// The composite key makes multiple tabs impossible to double count. Pruned
/// after 6 months by the daily job.
model ActiveMinute {
  userId String
  user   User     @relation("ActiveMinutes", fields: [userId], references: [id], onDelete: Cascade)
  minute DateTime
  module String

  @@id([userId, minute])
  @@index([minute])
}

/// A Supabase auth session (JWT `session_id`) seen for the first time is a real
/// sign-in; refreshes keep the same id.
model AuthSession {
  id          String   @id()
  userId      String
  user        User     @relation("AuthSessions", fields: [userId], references: [id], onDelete: Cascade)
  firstSeenAt DateTime @default(now())
  ip          String?
  userAgent   String?

  @@index([userId, firstSeenAt])
}

/// A CRO's end-of-day sales report: one per CRO per IST work day (4 am
/// boundary). Server-written by /api/sales-reports; never exposed on the
/// gateway. Sales and payments are not stored here, they are computed live.
model SalesReport {
  id               String    @id() @default(uuid())
  croId            String
  cro              User      @relation("SalesReports", fields: [croId], references: [id])
  day              DateTime  @db.Date()
  dayOff           Boolean   @default(false)
  enquiries        Int?
  leadFollowUps    Int?
  hotLeads         Int?
  plannedFollowUps Int?
  challenges       String?
  submittedAt      DateTime
  editedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt()

  @@unique([croId, day])
  @@index([day])
}
