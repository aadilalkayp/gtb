/// One per client. Holds workflow state plus the single-value sections
/// (Style Profile, Style Direction, Hair & Beard).
model StylingBlueprint {
  id                  String                    @id() @default(uuid())
  clientId            String                    @unique()
  client              Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status              BlueprintStatus           @default(awaiting_photos)
  photosSubmittedAt   DateTime?
  /// Stylist's turnaround target: photosSubmittedAt + 5 working days.
  dueAt               DateTime?
  publishedAt         DateTime?
  publishedVersion    Int                       @default(0)
  lastReminderAt      DateTime?
  /// Big Day Essentials the client has ticked (StylingEssential ids). Written
  /// by the client through /api/styling/essentials only.
  checkedEssentialIds String[]
  faceShape           String?
  skinTone            String?
  /// Optional swatch for the skin tone chip ("#a0714f").
  skinToneHex         String?
  hairType            String?
  beardType           String?
  bodyType            String?
  heightCm            Int?
  existingStyle       String?
  stylePreferences    String?
  styleTags           String[]
  styleDescription    String?
  hairFrontDocId      String?
  hairSideDocId       String?
  hairBackDocId       String?
  barberBrief         String[]
  hairNotes           String?
  /// Section keys (BLUEPRINT_SECTIONS) the stylist has marked done.
  sectionsDone        String[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt()
  photos              StylingPhoto[]
  looks               StylingLook[]
  palettes            StylingPalette[]
  items               StylingItem[]
  essentials          StylingEssential[]
  versions            StylingBlueprintVersion[]

  @@index([status, dueAt])
}

/// A client photo in one guided slot. The file is a styling_photo Document;
/// rows are created and replaced only by /api/styling/photos.
model StylingPhoto {
  id                String           @id() @default(uuid())
  blueprintId       String
  blueprint         StylingBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  slot              StylingPhotoSlot
  documentId        String           @unique()
  document          Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Set when the stylist asks for this photo again; cleared on re-upload.
  retakeNote        String?
  retakeRequestedAt DateTime?
  createdAt         DateTime         @default(now())

  @@index([blueprintId, slot])
}

/// Best Looks: an event-specific outfit, usually on the client's edited photo.
model StylingLook {
  id          String           @id() @default(uuid())
  blueprintId String
  blueprint   StylingBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  title       String
  /// Stylist-written occasion label ("Big day", "Reception"). Event-neutral.
  eventLabel  String?
  imageDocId  String?
  description String?
  outfit      String?
  footwear    String?
  accessories String?
  /// Hex swatches shown on the look card.
  colors      String[]
  stylistNote String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt()

  @@index([blueprintId, sortOrder])
}

/// Outfit Colours: one combination of swatches with a label and note.
model StylingPalette {
  id          String           @id() @default(uuid())
  blueprintId String
  blueprint   StylingBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  colors      String[]
  label       String
  notes       String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt()

  @@index([blueprintId, sortOrder])
}

/// Outfit Recommendations, Footwear, Eyewear and Shopping List products.
/// Fields a kind doesn't use stay null.
model StylingItem {
  id             String               @id() @default(uuid())
  blueprintId    String
  blueprint      StylingBlueprint     @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  kind           StylingItemKind
  name           String
  /// Shopping category ("Outfits", "Accessories", "Grooming") or outfit occasion.
  category       String?
  imageDocId     String?
  priceRange     String?
  url            String?
  priority       StylingItemPriority?
  color          String?
  fit            String?
  /// Eyewear: "Recommended", "Alternative" or "Avoid".
  recommendation String?
  notes          String?
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt()

  @@index([blueprintId, kind, sortOrder])
}

/// Big Day Essentials checklist item. The client's ticks live on the
/// Blueprint (checkedEssentialIds), so a republish keeps them.
model StylingEssential {
  id          String           @id() @default(uuid())
  blueprintId String
  blueprint   StylingBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  item        String
  category    String?
  notes       String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt()

  @@index([blueprintId, sortOrder])
}

/// Immutable published copy. The portal and the PDF read only this.
model StylingBlueprintVersion {
  id            String           @id() @default(uuid())
  blueprintId   String
  blueprint     StylingBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  version       Int
  /// BlueprintSnapshot (packages/shared/src/styling.ts).
  snapshot      Json
  publishedById String
  publishedBy   User             @relation("BlueprintPublisher", fields: [publishedById], references: [id])
  /// The generated styling_guide PDF, when generation succeeded.
  pdfDocumentId String?
  createdAt     DateTime         @default(now())

  @@unique([blueprintId, version])
}

/// Templates library: products, barber-brief lines and essentials the styling
