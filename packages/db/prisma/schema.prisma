  status             ClientStatus        @default(lead)
  leadPhase          LeadPhase           @default(new)
  avatarUrl          String?
  notes              String?
  cancellationReason String?
  onHoldReason       String?
  marketingOptOut    Boolean             @default(false)
  /// Bearer token in unsubscribe links; server-generated, never exposed via the gateway.
  unsubscribeToken   String?             @unique()
  userId             String?             @unique()
  user               User?               @relation("ClientUser", fields: [userId], references: [id])
  leadSourceId       String?
  leadSource         LeadSource?         @relation(fields: [leadSourceId], references: [id])
  convertedById      String?
  convertedBy        User?               @relation("ConvertedBy", fields: [convertedById], references: [id])
  conversionDate     DateTime?
  createdById        String?
  createdBy          User?               @relation("ClientCreator", fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  assessment         Assessment?
  clientPlan         ClientPlan?
  assignments        Assignment[]
  sessions           Session[]
  followUps          FollowUp[]
  stylingOps         StylingOperation[]
  stylingBlueprint   StylingBlueprint?
  conversations      Conversation[]
  documents          Document[]
  expenses           Expense[]
  tasks              Task[]
  scans              Scan[]
  roadmapItems       RoadmapItem[]
