/// Onboarding assessment (SRS §6.2, replaced by the Pre-Consultation
/// Assessment in Oct 2026). 1:1 with Client.
model Assessment {
  id                        String      @id() @default(uuid())
  clientId                  String      @unique()
  client                    Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  age                       Int?
  gender                    String?
  profilePhotoUrl           String?
  skinType                  String?
  skinConcerns              String[]
  skincareRoutine           String?
  allergies                 String?
  dermatologicalNotes       String?
  heightCm                  Int?
  weightKg                  Float?
  fitnessLevel              String?
  healthConditions          String?
  dietaryPreference         String?
  fitnessGoals              String[]
  bodyType                  String?
  stylePreferences          String[]
  outfitBudgetRange         String?
  colorPreferences          String?
  stylingNotes              String?
  fullBodyPhotoUrl          String?
  facePhotoUrl              String?
  completedAt               DateTime?
  skinConcernOther          String?
  skinAllergyFlag           Boolean?
  dermTreatmentFlag         Boolean?
  activityLevel             String?
  fitnessGoal               String?
  fitnessGoalOther          String?
  healthConditionFlag       Boolean?
  dietaryPreferenceOther    String?
  dietaryRestrictions       String?
  consentAccuracy           Boolean     @default(false)
  consentProfessionalReview Boolean     @default(false)
  /// Set when the pre-consultation form is submitted (null on older assessments).
  submittedAt               DateTime?
  /// Set when an admin reopens a submitted form so the client can change it.
  reopenedAt                DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt()
  skinPhotos                SkinPhoto[]
}

/// One of the three required skin assessment photos. The Document holds the
/// untouched original; `previewPath` a browser-made ~1600px JPEG used for
/// on-screen previews and the PDF (falls back to the original when absent).
model SkinPhoto {
  id           String         @id() @default(uuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  angle        SkinPhotoAngle
  documentId   String         @unique()
  document     Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  previewPath  String?
  createdAt    DateTime       @default(now())

  @@unique([assessmentId, angle])
}

model LeadSource {
  id        String   @id() @default(uuid())
  name      String   @unique()
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  clients   Client[]
}

model Plan {
  id             String        @id() @default(uuid())
  name           String
  clientType     ClientType
  durationMonths Int
  description    String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt()
  services       PlanService[]
  clientPlans    ClientPlan[]
}

model PlanService {
  id              String      @id() @default(uuid())
  planId          String
  plan            Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceType     ServiceType
  totalSessions   Int
  startOffsetDays Int
  frequencyDays   Int?
  notes           String?
}

/// A client's enrollment in a plan (1:1 — one active plan per client, SRS A9).
model ClientPlan {
  id               String             @id() @default(uuid())
  clientId         String             @unique()
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id])
  planNameSnapshot String
  agreedPrice      Int?
  durationMonths   Int
  servicesSnapshot Json?
  enrolledAt       DateTime           @default(now())
  milestones       PaymentMilestone[]
  payments         Payment[]
}

/// An expected payment checkpoint — a plan for the money, not the money itself
/// (that's Payment). "Behind"/"overdue" is DERIVED: at each due date, is the
/// cumulative approved amount >= the cumulative expected amount? Never stored.
model PaymentMilestone {
  id              String     @id() @default(uuid())
  clientPlanId    String
  clientPlan      ClientPlan @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  milestoneNumber Int
  amount          Int
  dueDate         DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt()

  @@unique([clientPlanId, milestoneNumber])
  @@index([dueDate])
  @@index([clientPlanId])
}

/// An actual payment (or waiver) against the plan balance. Clients submit any
/// amount with a proof; staff review it (approve/reject) or record money
/// directly. Approved rows reduce the balance; the first approved real payment
/// converts the lead (SRS §8.3/§8.5).
model Payment {
  id              String         @id() @default(uuid())
  clientPlanId    String
  clientPlan      ClientPlan     @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  amount          Int
  kind            PaymentKind    @default(payment)
  status          PaymentStatus  @default(pending_review)
  paymentMethod   PaymentMethod?
  proofDocumentId String?        @unique()
  proofDocument   Document?      @relation("PaymentProof", fields: [proofDocumentId], references: [id])
  submittedById   String?
  submittedBy     User?          @relation("PaymentSubmitter", fields: [submittedById], references: [id])
  approvedById    String?
  approvedBy      User?          @relation("PaymentApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  editedAt        DateTime?
  editedById      String?
  editedBy        User?          @relation("PaymentEditor", fields: [editedById], references: [id])
  voidReason      String?
  legacyImported  Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt()

  @@index([status])
  @@index([approvedAt])
  @@index([clientPlanId])
}

model Assignment {
  id           String         @id() @default(uuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staffId      String
  staff        User           @relation("StaffAssignments", fields: [staffId], references: [id])
  role         AssignmentRole
  assignedById String?
  assignedBy   User?          @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime       @default(now())
  unassignedAt DateTime?
  isActive     Boolean        @default(true)

  @@index([clientId, isActive])
  @@index([staffId, isActive])
}

model Session {
