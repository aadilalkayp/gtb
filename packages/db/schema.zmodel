// GTB OS data model + access policies.
//
// This is the single source of truth for the database. Run `pnpm db:generate`
// to emit the Prisma schema (./prisma/schema.prisma), the Prisma client, zod
// schemas, and the TanStack Query hooks consumed by the web app.
//
// Access-policy conventions:
//   - auth() is the User identity (staff or client), see @@auth on User.
//   - Policies only read scalar fields off auth(): auth().id and auth().role.
//   - "Assigned staff" is expressed by traversing the queried model's relations
//     (e.g. client.assignments) and comparing staffId == auth().id.
//   - "Client self" is expressed as <...>.userId == auth().id.
//   - Money is stored as whole INR rupees (Int) to keep JSON/runtime simple.

// Prisma 7: connection URLs live in prisma.config.ts (CLI) and are supplied at
// runtime via a driver adapter passed to PrismaClient — not in the schema.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

plugin prisma {
  provider = "@core/prisma"
  output   = "./prisma/schema.prisma"
}

plugin hooks {
  provider = "@zenstackhq/tanstack-query"
  target   = "react"
  version  = "v5"
  output   = "./src/generated/hooks"
}

plugin zod {
  provider = "@core/zod"
  output   = "./src/generated/zod"
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  founder
  ops_head
  cro
  coach
  skincare_consultant
  fitness_trainer
  styling_consultant
  media
  client
}

enum ClientType {
  groom
  bride
}

enum ClientStatus {
  lead
  converted
  active
  completed
  on_hold
  cancelled
}

enum LeadPhase {
  new
  contacted
  invited
  registered
  plan_selected
  payment_submitted
}

enum ServiceType {
  skincare
  fitness
  styling
}

enum SessionStatus {
  scheduled
  completed
  delayed
  missed
  cancelled
}

enum PaymentStatus {
  pending_review
  approved
  rejected
}

// A `waiver` settles balance without money changing hands (cancellation
// write-offs, discounts) — excluded from cash/collections metrics.
enum PaymentKind {
  payment
  waiver
}

enum PaymentMethod {
  upi
  bank_transfer
  cash
  other
}

enum AssignmentRole {
  cro
  coach
  skincare_consultant
  fitness_trainer
  styling_consultant
}

enum StylingStatus {
  upcoming
  in_progress
  completed
}

enum FollowUpType {
  weekly_checkin
  payment_reminder
  progress_update
  satisfaction_check
}

enum FollowUpStatus {
  pending
  completed
  overdue
}

enum ExpenseStatus {
  submitted
  approved
  rejected
}

enum DocumentType {
  assessment_form
  skincare_plan
  fitness_plan
  styling_guide
  consultation_notes
  payment_proof
  payment_receipt
  expense_receipt
  client_photo
  progress_photo
}

enum FitnessPlanStatus {
  active
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum ContentStage {
  planned
  shooting
  editing
  review
  posted
}

enum ContentType {
  photo
  video
  reel
  carousel
  story
  blog
}

enum ContentPlatform {
  instagram
  youtube
  facebook
  website
  other
}

enum Campaign {
  gtb
  glow_to_be
  general
}

enum ActivityAction {
  created
  updated
  deleted
  status_changed
}

enum ScanStatus {
  pending
  scored
  failed
}

enum RoadmapItemKind {
  weekly_focus
  checklist
}

enum ScanPhotoAngle {
  front
  left
  right
  full_body
}

enum OutfitVerdict {
  great
  good
  avoid
}

enum LookKind {
  hairstyle
  beard
}

enum LookStatus {
  pending
  ready
  failed
}

enum CoachRole {
  user
  assistant
}

enum CoachCategory {
  skin
  hair
  beard
  style
  fitness
  wedding
  general
}

enum MessageChannel {
  email
  whatsapp
}

enum MessageStatus {
  sent
  failed
  skipped
}

// ============================================================================
// Identity
// ============================================================================

/// Auth principal for both staff and clients. Linked to a Supabase auth user
/// via authId. Staff rows have a staff role; client rows have role = client and
/// a 1:1 Client profile.
model User {
  id        String  @id @default(uuid()) @deny('update', true)
  authId    String? @unique @deny('read', auth().role != founder && auth().role != ops_head && auth().role != cro && auth().role != coach && auth().role != skincare_consultant && auth().role != fitness_trainer && auth().role != styling_consultant && auth().role != media) // Supabase auth uid; null until first login/registration
  email     String  @unique @deny('update', auth().id == id && auth().role != founder) @deny('read', auth().role != founder && auth().role != ops_head && auth().role != cro && auth().role != coach && auth().role != skincare_consultant && auth().role != fitness_trainer && auth().role != styling_consultant && auth().role != media)
  name      String
  phone     String? @deny('read', auth().role != founder && auth().role != ops_head && auth().role != cro && auth().role != coach && auth().role != skincare_consultant && auth().role != fitness_trainer && auth().role != styling_consultant && auth().role != media)
  role      Role @deny('update', auth().id == id && auth().role != founder)
  avatarUrl String?
  isActive  Boolean @default(true) @deny('update', auth().id == id && auth().role != founder)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client            Client?            @relation("ClientUser")
  convertedClients  Client[]           @relation("ConvertedBy")
  assignments         Assignment[]     @relation("StaffAssignments")
  assignmentsMade     Assignment[]     @relation("AssignmentAssigner")
  paymentsApproved    Payment[]        @relation("PaymentApprover")
  paymentsSubmitted   Payment[]        @relation("PaymentSubmitter")
  consultantRates     ConsultantRate[]
  sessions          Session[]          @relation("ConsultantSessions")
  followUps         FollowUp[]         @relation("CroFollowUps")
  stylingOps        StylingOperation[] @relation("StylistOps")
  tasksAssigned     Task[]             @relation("TaskAssignee")
  tasksCreated      Task[]             @relation("TaskCreator")
  expensesSubmitted Expense[]          @relation("ExpenseSubmitter")
  expensesApproved  Expense[]          @relation("ExpenseApprover")
  expensesAsPayee   Expense[]          @relation("ExpensePayee")
  documentsUploaded Document[]         @relation("DocUploader")
  contentItems      ContentItem[]      @relation("ContentOwner")
  notifications     Notification[]     @relation("UserNotifications")
  activityLogs      ActivityLog[]      @relation("ActivityActor")
  fitnessPlansAsTrainer FitnessPlan[]     @relation("PlanTrainer")
  weightLogsRecorded    WeightLog[]       @relation("WeightRecorder")
  measurementsRecorded  BodyMeasurement[] @relation("MeasurementRecorder")
  trainerNotesAuthored  TrainerNote[]     @relation("TrainerNoteAuthor")

  @@auth

  // Any authenticated user can read staff identities (needed for team displays,
  // assignment dropdowns). Client identities are private to themselves + admins.
  @@allow('read', auth().id == id)
  // Any authenticated user can read staff identities (team displays, assignment
  // pickers). Client User rows stay private to the client + admins. Expressed as
  // a positive staff-role list because the bare literal `client` would collide
  // with the `client` relation field in this model's scope.
  @@allow('read', auth() != null && (role == founder || role == ops_head || role == cro || role == coach || role == skincare_consultant || role == fitness_trainer || role == styling_consultant || role == media))
  @@allow('read', auth().role == founder || auth().role == ops_head)
  // Only the founder manages user accounts; users may update their own profile
  // (name/phone/avatarUrl only — privileged fields are founder-only).
  @@allow('create', auth().role == founder)
  @@allow('update', auth().role == founder || auth().id == id)
  // authId is nullable, and ZenStack field-level denies don't reliably fire on
  // optional fields — so the auth-row hijack guard also lives at model level
  // (post-update: fires only when the field actually changes).
  @@deny('update', auth().id == id && auth().role != founder && future().authId != authId)
}

// ============================================================================
// Clients & onboarding
// ============================================================================

model Client {
  id                String        @id @default(uuid()) @deny('update', true)
  clientCode        String        @unique @deny('update', userId != null && userId == auth().id) // human-friendly, e.g. "GTB1256"
  name              String
  phone             String
  email             String @deny('update', userId != null && userId == auth().id)
  type              ClientType @deny('update', userId != null && userId == auth().id)
  // Wedding-date changes must recalculate the session schedule (SRS §24.1), so
  // the only writer is the clients/wedding-date server route — never the gateway.
  weddingDate       DateTime @deny('update', true)
  city              String @deny('update', userId != null && userId == auth().id)
  status            ClientStatus  @default(lead) @deny('update', userId != null && userId == auth().id)
  leadPhase         LeadPhase     @default(new)
  avatarUrl         String?
  notes             String? @deny('update', userId != null && userId == auth().id)
  cancellationReason String? @deny('update', userId != null && userId == auth().id)
  onHoldReason      String? @deny('update', userId != null && userId == auth().id)

  // Funnel messaging (scan report + follow-up drips). Transactional mail to
  // enrolled clients (invites, session reminders) is unaffected by the opt-out.
  marketingOptOut  Boolean @default(false) @deny('update', userId != null && userId == auth().id)
  /// Bearer token in unsubscribe links; server-generated, never exposed via the gateway.
  unsubscribeToken String? @unique @deny('read', auth().role != founder && auth().role != ops_head) @deny('update', true)

  // Auth link (null while a pre-registration lead)
  userId String? @unique @deny('update', userId != null && userId == auth().id)
  user   User?   @relation("ClientUser", fields: [userId], references: [id])

  // Sales
  leadSourceId   String? @deny('update', userId != null && userId == auth().id)
  leadSource     LeadSource? @relation(fields: [leadSourceId], references: [id])
  convertedById  String? @deny('update', userId != null && userId == auth().id)
  convertedBy    User?       @relation("ConvertedBy", fields: [convertedById], references: [id])
  conversionDate DateTime? @deny('update', userId != null && userId == auth().id)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assessment  Assessment?
  clientPlan  ClientPlan?
  assignments Assignment[]
  sessions    Session[]
  followUps   FollowUp[]
  stylingOps  StylingOperation[]
  documents   Document[]
  expenses    Expense[]
  tasks       Task[]
  scans        Scan[]
  roadmapItems RoadmapItem[]
  fitnessPlans     FitnessPlan[]
  weightLogs       WeightLog[]
  bodyMeasurements BodyMeasurement[]
  trainerNotes     TrainerNote[]
  outboundMessages OutboundMessage[]
  outfitChecks  OutfitCheck[]
  lookPreviews  LookPreview[]
  coachThreads  CoachConversation[]

  @@index([status])
  @@index([type])
  @@index([weddingDate])

  @@allow('read', auth().role == founder || auth().role == ops_head || auth().role == cro)
  @@allow('read', assignments?[staffId == auth().id && isActive])
  @@allow('read', userId == auth().id)
  @@allow('create', auth().role == founder || auth().role == ops_head || auth().role == cro)
  @@allow('update', auth().role == founder || auth().role == ops_head)
  @@allow('update', assignments?[staffId == auth().id && isActive && (role == cro || role == coach)])
  // Client self-service: profile fields (name/phone/avatarUrl) and forward-only
  // leadPhase transitions (SEC-3). Never status/clientCode/conversionDate etc.
  @@allow('update',
    userId == auth().id && (
      future().leadPhase == leadPhase ||
      (future().leadPhase == contacted && leadPhase == new) ||
      (future().leadPhase == invited && (leadPhase == new || leadPhase == contacted)) ||
      (future().leadPhase == registered && (leadPhase == new || leadPhase == contacted || leadPhase == invited)) ||
      (future().leadPhase == plan_selected && (leadPhase == new || leadPhase == contacted || leadPhase == invited || leadPhase == registered)) ||
      (future().leadPhase == payment_submitted && (leadPhase == new || leadPhase == contacted || leadPhase == invited || leadPhase == registered || leadPhase == plan_selected))
    ))
  // DATA-1: no hard deletes — client data is retained for reporting (SRS §24.3);
  // "removal" is the cancellation cascade (clients/cancel).
  // The auth link is server-managed (clients/invite + auth resolution): no
  // gateway caller may relink a client record to a different User (the gateway
  // analogue of SEC-8 — an assigned CRO could otherwise hand a staff account
  // every client-ownership grant). userId is nullable, so this lives at model
  // level (field denies don't reliably fire on optional fields).
  @@deny('update', future().userId != userId)
}

/// Full onboarding assessment (SRS §6.2). 1:1 with Client.
// SEC-17: fields carry @allow('update') scoping which service's staff (or the
// owning client) may write them; the client owns the whole form, consultants
// are limited to their own service's fields, completedAt is client/admin-only.
model Assessment {
  id       String @id @default(uuid()) @deny('update', true)
  clientId String @unique @deny('update', true)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // General
  age             Int? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id)
  gender          String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id)
  profilePhotoUrl String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id)

  // Skincare
  skinType            String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == skincare_consultant)
  skinConcerns        String[] @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == skincare_consultant)
  skincareRoutine     String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == skincare_consultant)
  allergies           String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == skincare_consultant)
  dermatologicalNotes String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == skincare_consultant)

  // Fitness
  heightCm         Int? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == fitness_trainer)
  weightKg         Float? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == fitness_trainer)
  fitnessLevel     String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == fitness_trainer)
  healthConditions String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == fitness_trainer)
  dietaryPreference String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == fitness_trainer)
  fitnessGoals     String[] @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == fitness_trainer)

  // Styling
  bodyType          String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == styling_consultant)
  stylePreferences  String[] @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == styling_consultant)
  outfitBudgetRange String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == styling_consultant)
  colorPreferences  String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == styling_consultant)
  stylingNotes      String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id || auth().role == styling_consultant)

  // Photos
  fullBodyPhotoUrl String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id)
  facePhotoUrl     String? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id)

  completedAt DateTime? @allow('update', auth().role == founder || auth().role == ops_head || client.userId == auth().id)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  @@allow('create,update', auth().role == founder || auth().role == ops_head)
  @@allow('create,update', client.userId == auth().id)
  @@allow('update', client.assignments?[staffId == auth().id && isActive && (role == skincare_consultant || role == fitness_trainer || role == styling_consultant)])
}

model LeadSource {
  id        String   @id @default(uuid()) @deny('update', true)
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  clients Client[]

  // Marketing-channel names are internal — staff only (clients never pick one).
  @@allow('read', auth() != null && auth().role != client)
  @@allow('create,update', auth().role == founder || auth().role == ops_head)
}

// ============================================================================
// Plans
// ============================================================================

model Plan {
  id              String     @id @default(uuid()) @deny('update', true)
  name            String
  clientType      ClientType
  durationMonths  Int
  price           Int // whole INR
  description     String?
  // TEMPLATE only: pre-fills the per-client milestone schedule at enrollment
  // (evenly split); staff can edit the schedule per client.
  installmentCount Int       @default(1)
  isActive        Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services    PlanService[]
  clientPlans ClientPlan[]

  // Everyone authenticated can read plans (clients browse them at onboarding);
  // clients see active plans only — inactive plans and their pricing stay
  // internal (SEC-14).
  @@allow('read', auth() != null && (auth().role != client || isActive))
  @@allow('create,update,delete', auth().role == founder)
}

model PlanService {
  id             String      @id @default(uuid()) @deny('update', true)
  planId         String
  plan           Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceType    ServiceType
  totalSessions  Int
  startOffsetDays Int        // days before wedding this service starts
  frequencyDays  Int?        // null => only first session auto-scheduled (e.g. styling)
  notes          String?

  // Mirror the Plan read rule (SEC-14): clients must not enumerate the service
  // composition of inactive plans or the opposite client type's offering.
  @@allow('read', auth() != null && (auth().role != client || plan.isActive))
  @@allow('create,update,delete', auth().role == founder)
}

/// A client's enrollment in a plan (1:1 — one active plan per client, SRS A9).
model ClientPlan {
  id               String   @id @default(uuid()) @deny('update', true)
  clientId         String   @unique @deny('update', true)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  planId           String
  plan             Plan     @relation(fields: [planId], references: [id])
  planNameSnapshot String   // plan name captured at enrollment
  priceAtEnrollment Int
  durationMonths   Int
  // SYS-4: the service rules captured at enrollment, so editing a plan never
  // retroactively changes an enrolled client's schedule or assignable roles.
  // JSON array of { serviceType, totalSessions, startOffsetDays, frequencyDays }.
  servicesSnapshot Json?
  enrolledAt       DateTime @default(now())

  milestones PaymentMilestone[]
  payments   Payment[]

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  // Enrollment happens exclusively through the clients/enroll server route
  // (price + services snapshotted server-side). Gateway writes are admin-only
  // correction paths — a CRO could otherwise rewrite priceAtEnrollment or the
  // SYS-4 servicesSnapshot on any enrollment in the business.
  @@allow('create,update', auth().role == founder || auth().role == ops_head)
}

/// An expected payment checkpoint — a plan for the money, not the money itself
/// (that's Payment). "Behind"/"overdue" is DERIVED: at each due date, is the
/// cumulative approved amount >= the cumulative expected amount? Never stored.
model PaymentMilestone {
  id              String     @id @default(uuid()) @deny('update', true)
  clientPlanId    String @deny('update', true)
  clientPlan      ClientPlan @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  milestoneNumber Int
  amount          Int
  dueDate         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientPlanId, milestoneNumber])
  @@index([dueDate])
  // DATA-5: Postgres doesn't auto-index FKs; payment pages filter by plan.
  @@index([clientPlanId])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', clientPlan.client.assignments?[staffId == auth().id && isActive && (role == cro || role == coach)])
  @@allow('read', clientPlan.client.userId == auth().id)
  // Schedule edits go exclusively through the payments/milestones server route
  // (sum-equals-price invariant + audit log live there). Gateway writes are
  // admin-only correction paths.
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
}

/// An actual payment (or waiver) against the plan balance. Clients submit any
/// amount with a proof; staff review it (approve/reject) or record money
/// directly. Approved rows reduce the balance; the first approved real payment
/// converts the lead (SRS §8.3/§8.5).
model Payment {
  id              String        @id @default(uuid()) @deny('update', true)
  clientPlanId    String @deny('update', true)
  clientPlan      ClientPlan    @relation(fields: [clientPlanId], references: [id], onDelete: Restrict)
  amount          Int @deny('update', clientPlan.client.userId != null && clientPlan.client.userId == auth().id)
  kind            PaymentKind   @default(payment) @deny('update', clientPlan.client.userId != null && clientPlan.client.userId == auth().id)
  status          PaymentStatus @default(pending_review)
  paymentMethod   PaymentMethod? @deny('update', clientPlan.client.userId != null && clientPlan.client.userId == auth().id)
  proofDocumentId String?       @unique
  proofDocument   Document?     @relation("PaymentProof", fields: [proofDocumentId], references: [id])
  submittedById   String? @deny('update', true)
  submittedBy     User?         @relation("PaymentSubmitter", fields: [submittedById], references: [id])
  approvedById    String? @deny('update', clientPlan.client.userId != null && clientPlan.client.userId == auth().id)
  approvedBy      User?         @relation("PaymentApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime? @deny('update', clientPlan.client.userId != null && clientPlan.client.userId == auth().id)
  rejectionReason String? @deny('update', clientPlan.client.userId != null && clientPlan.client.userId == auth().id)
  notes           String? @deny('update', clientPlan.client.userId != null && clientPlan.client.userId == auth().id)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([approvedAt])
  // DATA-5: Postgres doesn't auto-index FKs; payment pages filter by plan.
  @@index([clientPlanId])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', clientPlan.client.assignments?[staffId == auth().id && isActive && (role == cro || role == coach)])
  @@allow('read', clientPlan.client.userId == auth().id)
  // Writes mirror the read scope: a CRO touches only payments of clients they
  // are actively assigned to — never arbitrary plans across the business.
  @@allow('create', auth().role == founder || auth().role == ops_head)
  @@allow('create', auth().role == cro && clientPlan.client.assignments?[staffId == auth().id && isActive && role == cro])
  @@allow('update', auth().role == founder || auth().role == ops_head)
  @@allow('update', auth().role == cro && clientPlan.client.assignments?[staffId == auth().id && isActive && role == cro])
  // A CRO approving through the gateway cannot attribute the approval to
  // someone else. Expressed against the post-write value only — comparing with
  // the nullable pre-value trips ZenStack's null-comparison semantics and
  // denies legitimate first approvals.
  @@deny('update', auth().role == cro && future().approvedById != null && future().approvedById != auth().id)
  // Clients have NO gateway write path: payment submission goes exclusively
  // through the payments/submit server route, which validates the amount
  // against the balance, that the proof document belongs to the client, and
  // advances leadPhase atomically (SEC-2 + STATE-6 — a gateway path would let
  // a client attach any document id, including another client's, as proof).
}

// ============================================================================
// Assignments
// ============================================================================

model Assignment {
  id           String         @id @default(uuid()) @deny('update', true)
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staffId      String
  staff        User           @relation("StaffAssignments", fields: [staffId], references: [id])
  role         AssignmentRole
  assignedById String?
  assignedBy   User?          @relation("AssignmentAssigner", fields: [assignedById], references: [id])
  assignedAt   DateTime       @default(now())
  unassignedAt DateTime?
  isActive     Boolean        @default(true)

  @@index([clientId, isActive])
  @@index([staffId, isActive])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', staffId == auth().id)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
}

// ============================================================================
// Sessions
// ============================================================================

model Session {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceType   ServiceType
  consultantId  String?
  consultant    User?         @relation("ConsultantSessions", fields: [consultantId], references: [id])
  sessionNumber Int
  scheduledDate DateTime
  actualDate    DateTime?
  // DATA-2: the first-scheduled date, preserved once a reschedule happens
  // (SRS §9.4 "Original scheduled date is preserved in history for reporting").
  originalScheduledDate DateTime?
  status        SessionStatus @default(scheduled)
  notes         String?
  rating        Int?          // 1-5, set by client
  ratingFeedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents        Document[]
  stylingOperation StylingOperation?

  // STATE-2: the DB backstop for the double-activation race — a session number
  // per service can only exist once per client.
  @@unique([clientId, serviceType, sessionNumber])

  @@index([clientId])
  @@index([consultantId])
  @@index([scheduledDate])
  @@index([status])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', consultantId == auth().id)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  @@allow('create', auth().role == founder || auth().role == ops_head)
  // Session mutation is server-route-only for everyone below admin. ZenStack
  // 2.22 cannot express field restrictions on this model (field-level denies
  // and pre/post-update status references break ALL Session updates — runtime
  // bug, see REMEDIATION_PLAN.md notes), so any gateway grant is an
  // every-field grant. A consultant gateway path let consultants self-award
  // ratings, self-complete sessions (skipping the payout expense + audit in
  // sessions/complete), and rewrite clientId/scheduledDate. Consultants act
  // through the server routes instead: sessions/complete, sessions/reschedule,
  // sessions/cancel. Clients rate via sessions/rate (ownership + completed +
  // 1-5 validated server-side; range also DB CHECK-enforced).
  @@allow('update', auth().role == founder || auth().role == ops_head)
  // Record ids are immutable (SEC-19; model-level because field-level denies
  // are unsafe on this model).
  @@deny('update', future().id != id)
}

// ============================================================================
// Follow-ups (CRO tracking)
// ============================================================================

model FollowUp {
  id            String         @id @default(uuid()) @deny('update', true)
  // A follow-up never moves to another client, and only admins may reattribute
  // it to a different CRO — a CRO could otherwise create-then-update past the
  // SEC-16 assignment guard, or dump completion credit on a colleague.
  clientId      String @deny('update', true)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  croId         String @deny('update', auth().role != founder && auth().role != ops_head)
  cro           User           @relation("CroFollowUps", fields: [croId], references: [id])
  type          FollowUpType
  dueDate       DateTime
  completedDate DateTime?
  status        FollowUpStatus @default(pending)
  notes         String?

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([croId, status])
  @@index([dueDate])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', croId == auth().id)
  @@allow('read', client.assignments?[staffId == auth().id && isActive && role == coach])
  @@allow('create', auth().role == founder || auth().role == ops_head)
  // A CRO may only create follow-ups for a client they are actively assigned to
  // (SEC-16), never for arbitrary clients.
  @@allow('create', croId == auth().id && client.assignments?[staffId == auth().id && isActive && role == cro])
  @@allow('update', auth().role == founder || auth().role == ops_head)
  @@allow('update', croId == auth().id)
  @@allow('update', client.assignments?[staffId == auth().id && isActive && role == coach])
}

// ============================================================================
// Styling operations
// ============================================================================

model StylingOperation {
  id              String        @id @default(uuid()) @deny('update', true)
  clientId        String @deny('update', true)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sessionId       String?       @unique
  session         Session?      @relation(fields: [sessionId], references: [id])
  stylistId       String?
  stylist         User?         @relation("StylistOps", fields: [stylistId], references: [id])
  stylingDate     DateTime?
  stylingLocation String?
  travelRequired  Boolean       @default(false)
  travelDetails   String?
  status          StylingStatus @default(upcoming)

  // Checklist (SRS §10.2)
  consultationDone       Boolean   @default(false)
  consultationDoneAt     DateTime?
  outfitFinalized        Boolean   @default(false)
  outfitFinalizedAt      DateTime?
  accessoriesFinalized   Boolean   @default(false)
  accessoriesFinalizedAt DateTime?
  guideDelivered         Boolean   @default(false)
  guideDeliveredAt       DateTime?
  finalConfirmation      Boolean   @default(false)
  finalConfirmationAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stylingDate])
  @@index([status])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', stylistId == auth().id)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  @@allow('create,delete', auth().role == founder || auth().role == ops_head)
  @@allow('update', auth().role == founder || auth().role == ops_head)
  @@allow('update', stylistId == auth().id)
  // The assigned stylist works the checklist/status — they don't relink the
  // operation to another session or hand it to a different stylist (both
  // nullable FKs, so the guards are model-level).
  @@deny('update', auth().role != founder && auth().role != ops_head && (future().sessionId != sessionId || future().stylistId != stylistId))
}

// ============================================================================
// Documents
// ============================================================================

model Document {
  id           String       @id @default(uuid())
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  type         DocumentType
  fileName     String
  fileUrl      String
  fileSize     Int
  sessionId    String?
  session      Session?     @relation(fields: [sessionId], references: [id])
  uploadedById String
  uploadedBy   User         @relation("DocUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  paymentProof     Payment?     @relation("PaymentProof")
  expenseReceipt   Expense?     @relation("ExpenseReceipt")

  @@index([clientId])
  @@index([type])
  // DATA-5: session-scoped document lookups (pending-upload checks).
  @@index([sessionId])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  // Assigned staff see client documents, except the financial types that are
  // restricted by SRS §16.1: payment_proof is CRO/Ops/Founder only,
  // expense_receipt is Ops/Founder only (SEC-10).
  @@allow('read', client.assignments?[staffId == auth().id && isActive] && (type != payment_proof || auth().role == cro) && type != expense_receipt)
  // Client sees own documents except internal consultation notes.
  @@allow('read', client.userId == auth().id && type != consultation_notes)
  // Gateway creates are intentionally not allowed: every Document row must be
  // created by the server upload route, which validates ownership and builds a
  // traversal-safe storage key (SEC-5). Deletes are admin-only.
  @@allow('delete', auth().role == founder || auth().role == ops_head)
}

// ============================================================================
// Consultant rates & expenses
// ============================================================================

/// Per-session fee for a consultant, optionally specific to a service type.
model ConsultantRate {
  id          String      @id @default(uuid()) @deny('update', true)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType ServiceType
  amount      Int
  createdAt   DateTime    @default(now())

  @@unique([userId, serviceType])

  @@allow('read', auth().role == founder || auth().role == ops_head || userId == auth().id)
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @deny('update', true)
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  expenses Expense[]

  @@allow('read', auth() != null && auth().role != client)
  @@allow('create,update,delete', auth().role == founder)
}

model Expense {
  id                String        @id @default(uuid()) @deny('update', true)
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  title             String
  amount            Int
  date              DateTime
  paidTo            String?
  submittedById     String
  submittedBy       User          @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  // Optional links: a client-related expense, a consultant payout, a session fee.
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id])
  payeeId           String?
  payee             User?         @relation("ExpensePayee", fields: [payeeId], references: [id])
  sessionId         String?
  status            ExpenseStatus @default(submitted) @deny('update', submittedById == auth().id && auth().role != founder && auth().role != ops_head)
  approvedById      String? @deny('update', submittedById == auth().id && auth().role != founder && auth().role != ops_head)
  approvedBy        User?         @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt        DateTime? @deny('update', submittedById == auth().id && auth().role != founder && auth().role != ops_head)
  receiptDocumentId String?       @unique
  receiptDocument   Document?     @relation("ExpenseReceipt", fields: [receiptDocumentId], references: [id])
  notes             String?
  // FEAT-10: the rejector's reason lives here — it never overwrites the
  // submitter's notes.
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([date])
  // DATA-5: FK indexes for payout summaries (grouped by payee/submitter) and
  // client/category expense filters.
  @@index([submittedById])
  @@index([payeeId])
  @@index([clientId])
  @@index([categoryId])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', submittedById == auth().id || payeeId == auth().id)
  // Any staff member may submit an expense (clients may not).
  @@allow('create', auth().role == founder || auth().role == ops_head || auth().role == cro || auth().role == coach || auth().role == skincare_consultant || auth().role == fitness_trainer || auth().role == styling_consultant || auth().role == media)
  // SEC-6: only admins may create an expense that is not a self-submitted draft —
  // no pre-approved expenses, no spoofed submitter.
  @@deny('create', auth().role != founder && auth().role != ops_head && (status != submitted || submittedById != auth().id || approvedById != null || approvedAt != null))
  @@allow('update', auth().role == founder || auth().role == ops_head)
  // Submitter may edit their own expense while it is still pending submission.
  @@allow('update', submittedById == auth().id && status == submitted)
  @@allow('delete', auth().role == founder)
}

// ============================================================================
// Media
// ============================================================================

model ContentItem {
  id          String          @id @default(uuid()) @deny('update', true)
  title       String
  contentType ContentType
  campaign    Campaign
  platform    ContentPlatform
  ownerId     String?
  owner       User?           @relation("ContentOwner", fields: [ownerId], references: [id])
  deadline    DateTime?
  status      ContentStage    @default(planned)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])

  // The media team collaborates on the board (any media user moves cards), but
  // destroying the content calendar is founder-only — 'all' handed every media
  // account delete-everything rights.
  @@allow('read,create,update', auth().role == founder || auth().role == media)
  @@allow('delete', auth().role == founder)
}

// ============================================================================
// Tasks
// ============================================================================

model Task {
  id           String       @id @default(uuid()) @deny('update', true)
  title        String
  description  String?
  // The assignee works the task; only admins or the creator move it to someone
  // else — an assignee could otherwise dump work on a colleague.
  assignedToId String @deny('update', auth().role != founder && auth().role != ops_head && assignedById != auth().id)
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  // The creator attribution is immutable: an assignee rewriting it to
  // themselves would acquire delete rights, and rewriting it to the founder
  // forges "assigned by the founder".
  assignedById String @deny('update', true)
  assignedBy   User         @relation("TaskCreator", fields: [assignedById], references: [id])
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  dueDate      DateTime?
  priority     TaskPriority @default(medium)
  status       TaskStatus   @default(pending)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([assignedToId, status])
  @@index([clientId])
  @@index([dueDate])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', assignedToId == auth().id || assignedById == auth().id)
  // Any staff member may create/assign tasks (clients may not) — but always as
  // themselves: a spoofed assignedById makes a task appear to come from the
  // founder (same class as SEC-6's submittedById guard).
  @@allow('create', auth().role == founder || auth().role == ops_head || auth().role == cro || auth().role == coach || auth().role == skincare_consultant || auth().role == fitness_trainer || auth().role == styling_consultant || auth().role == media)
  @@deny('create', auth().role != founder && auth().role != ops_head && assignedById != auth().id)
  @@allow('update', auth().role == founder || auth().role == ops_head)
  @@allow('update', assignedToId == auth().id || assignedById == auth().id)
  // clientId is nullable, so its immutability guard is model-level: repointing
  // a task at a client the caller has no access to leaks that client's name
  // into their board.
  @@deny('update', auth().role != founder && auth().role != ops_head && future().clientId != clientId)
  @@allow('delete', assignedById == auth().id || auth().role == founder || auth().role == ops_head)
}

// ============================================================================
// Transformation Readiness Scan (companion funnel)
// ============================================================================

/// One AI readiness scan: a selfie scored by the vision pipeline. Created and
/// scored exclusively by the /api/scan/* server routes (the public funnel runs
/// pre-auth, and score fields must never be client-writable) — the gateway
/// exposes no create/update below admin. clientId is null while a scan is
/// anonymous (pre email capture); unclaimed scans are purged by the daily job.
model Scan {
  id       String  @id @default(uuid()) @deny('update', true)
  clientId String? @deny('update', true)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  /// Storage object path in the private scan-photos bucket (never a public URL).
  photoPath String
  /// Capture channel — "web" today; "whatsapp" / "telegram" / "app" later. The
  /// scoring pipeline is channel-agnostic so new capture surfaces just tag this.
  source String @default("web")
  /// Wedding date captured with the scan (copied to the Client at claim time).
  weddingDate DateTime
  type        ClientType @default(groom)

  status       ScanStatus @default(pending)
  modelVersion String?
  failureReason String?

  // Scores are 0–100 appearance ratings (analysis, not diagnosis — the pipeline
  // schema has no field a medical condition could fit in).
  skinScore      Int?
  hairScore      Int?
  beardScore     Int?
  styleScore     Int?
  readinessScore Int?
  /// JSON array of { area, weight } — e.g. [{"area":"pigmentation","weight":70}].
  focusAreas Json?
  /// Positive observations shown to the user ("Strong jawline definition").
  highlights String[]
  /// Improvement pointers feeding the roadmap ("Hydration routine, twice daily").
  suggestions String[]
  /// Attribute-level appearance metrics, JSON array of { key, label, score }
  /// (tone evenness, clarity, hydration look, under-eye, hair density…). Neutral
  /// appearance names only — never condition names.
  attributes Json?

  // Self-reported inputs to the composite Groom Score (a face photo can't
  // honestly rate fitness or confidence). Raw answers + derived 0–100 scores.
  selfReport      Json?
  fitnessScore    Int?
  confidenceScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos        ScanPhoto[]
  outfitChecks  OutfitCheck[]
  lookPreviews  LookPreview[]
  coachThreads  CoachConversation[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  @@allow('delete', auth().role == founder || auth().role == ops_head)
}

/// Additional angles for a scan (front is Scan.photoPath). A full-body photo
/// unlocks the Style score; side angles sharpen hair/beard scoring. Same
/// bucket, same retention, same read policy as the parent scan.
model ScanPhoto {
  id     String @id @default(uuid()) @deny('update', true)
  scanId String @deny('update', true)
  scan   Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  angle ScanPhotoAngle
  /// Storage object path in the private scan-photos bucket.
  path  String

  createdAt DateTime @default(now())

  @@index([scanId])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', scan.client.assignments?[staffId == auth().id && isActive])
  @@allow('read', scan.client.userId == auth().id)
}

/// A self-serve prep task on the client's readiness roadmap — weekly focus items
/// generated from scan results plus fixed checklist milestones (suit trial,
/// ring, packing…), all offset from the wedding date. Distinct from Session
/// (consultant-delivered); the portal renders both on one timeline.
model RoadmapItem {
  id       String @id @default(uuid()) @deny('update', true)
  clientId String @deny('update', true)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  kind        RoadmapItemKind
  /// skin | hair | beard | style | fitness | logistics
  category    String
  title       String
  description String?
  dueDate     DateTime
  /// 1-based week index for weekly_focus items (null for checklist milestones).
  weekNumber Int?

  isDone Boolean   @default(false)
  doneAt DateTime?

  createdAt DateTime @default(now())

  @@index([clientId, dueDate])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  // Items are generated by the scan/claim + rescan server routes; admins may
  // correct anything. The owning client only ticks items off — the content
  // fields are immutable to them (nullable fields make this model-level).
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
  @@allow('update', client.userId == auth().id)
  @@deny('update',
    auth().role != founder && auth().role != ops_head &&
    (future().title != title || future().category != category || future().kind != kind ||
     future().dueDate != dueDate || future().weekNumber != weekNumber ||
     future().description != description))
}

/// Every funnel message sent to a client (scan report, drips, rescan nudges),
/// one row per (client, template). Doubles as the idempotency key for the
/// daily drip job and as the staff-visible send history. Written only by the
/// server's channel layer (apps/api/src/lib/channels.ts).
model OutboundMessage {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  channel  MessageChannel
  /// Template key, e.g. "scan_report", "drip_day3_focus" (see funnelTemplates.ts).
  template String
  status   MessageStatus
  /// Provider message id when available (Mailgun / WhatsApp), for support lookups.
  providerId String?
  error      String?

  createdAt DateTime @default(now())

  @@unique([clientId, template, channel])
  @@index([clientId, createdAt])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive && (role == cro || role == coach)])
}

// ============================================================================
// Phase 6 — outfit analysis, look previews, AI coach
// ============================================================================

/// One outfit check: up to three garment photos judged against the person's
/// skin tone (from their scan's front selfie). Anchored to a scan so funnel
/// leads can use it from their report page (scanId = bearer secret); enrolled
/// clients see history in the portal. Photos live in the scan-photos bucket.
model OutfitCheck {
  id       String  @id @default(uuid()) @deny('update', true)
  scanId   String  @deny('update', true)
  scan     Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  clientId String? @deny('update', true)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  /// Storage paths of the garment photos, in upload order.
  photoPaths   String[]
  modelVersion String?
  /// Per-garment results: [{ index, verdict, score, colorNote, fitNote, suggestion }]
  results Json?
  /// Palette guidance: { tryColors: string[], avoidColors: string[], summary }
  palette Json?

  createdAt DateTime @default(now())

  @@index([scanId])
  @@index([clientId, createdAt])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
}

/// A generated hairstyle / beard preview rendered onto the person's own
/// selfie. Costs real money per render, so creation is server-only and capped
/// per scan per day and globally per month (see looks.ts).
model LookPreview {
  id       String  @id @default(uuid()) @deny('update', true)
  scanId   String  @deny('update', true)
  scan     Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  clientId String? @deny('update', true)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  kind     LookKind
  /// Catalog key from packages/shared/src/looks.ts (e.g. "textured_crop").
  styleKey String
  status   LookStatus @default(pending)
  /// Storage path of the generated image (scan-photos bucket) once ready.
  path         String?
  modelVersion String?
  error        String?

  createdAt DateTime @default(now())

  @@index([scanId, createdAt])
  @@index([clientId, createdAt])
  @@index([createdAt])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
}

/// The coach's knowledge base: GTB's methodology as staff-editable articles.
/// The coach answers ONLY from active articles plus the user's own scan
/// context. Ships empty (a starter set can be created from Settings) — GTB
/// owns the content.
model CoachArticle {
  id       String        @id @default(uuid()) @deny('update', true)
  title    String
  category CoachCategory
  /// Markdown body. Keep articles focused: one topic, one answerable question.
  content  String
  tags     String[]
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])

  // Staff read everything; clients only what's live (they never see drafts).
  @@allow('read', auth() != null && (auth().role != client || isActive))
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
}

/// A coach chat thread. Anchored to a scan (funnel leads, bearer secret) and,
/// once known, the client. Messages are server-written.
model CoachConversation {
  id       String  @id @default(uuid()) @deny('update', true)
  scanId   String? @deny('update', true)
  scan     Scan?   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  clientId String? @deny('update', true)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages CoachMessage[]

  @@index([clientId, updatedAt])
  @@index([scanId])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive && (role == coach || role == cro)])
  @@allow('read', client.userId == auth().id)
}

model CoachMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           CoachRole
  content        String
  /// Titles of the knowledge articles the answer drew on (assistant turns).
  sources String[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', conversation.client.assignments?[staffId == auth().id && isActive && (role == coach || role == cro)])
  @@allow('read', conversation.client.userId == auth().id)
}

// ============================================================================
// Fitness module (client sketches, Sep 2026)
// ============================================================================

/// A client's fitness program: a fixed-length day-by-day journey (default 30
/// days) owned by the assigned fitness trainer. Health status ("on track",
/// "needs follow-up") is DERIVED from the days — never stored (see
/// @gtb/shared fitness.ts), the same principle as payment pace.
model FitnessPlan {
  id       String @id @default(uuid()) @deny('update', true)
  clientId String @deny('update', true)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  trainerId String?
  trainer   User?   @relation("PlanTrainer", fields: [trainerId], references: [id])

  title        String
  /// Free-text goal shown on both portals, e.g. "Fat loss & better stamina".
  goal         String
  /// FITNESS_TEMPLATES key the days were seeded from (null for custom plans).
  templateKey  String?
  startDate    DateTime
  durationDays Int      @default(30)
  status       FitnessPlanStatus @default(active)

  startWeightKg  Float?
  targetWeightKg Float?
  /// Shown as the portal "Nutrition note"; the full diet plan is a
  /// fitness_plan Document.
  dietNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days     FitnessWorkoutDay[]
  checkIns FitnessCheckIn[]

  @@index([clientId, status])
  @@index([status, startDate])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  // The assigned trainer (or admin) authors and manages the plan. Clients
  // never write plans.
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
  @@allow('create,update', client.assignments?[staffId == auth().id && isActive && role == fitness_trainer])
  // trainerId is nullable, so reassignment protection is model-level: the
  // trainer works the plan but only admins hand it to someone else. startDate
  // is pinned too — day rows carry concrete dates, so moving the start would
  // silently desync the journey (admin correction path only).
  @@deny('update', auth().role != founder && auth().role != ops_head && (future().trainerId != trainerId || future().startDate != startDate))
}

/// One day of a fitness plan. dayIndex is the 1-based journey day; date is the
/// concrete IST day it falls on (denormalized for querying and the cron nudge).
model FitnessWorkoutDay {
  id     String      @id @default(uuid()) @deny('update', true)
  planId String      @deny('update', true)
  plan   FitnessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  dayIndex  Int
  date      DateTime
  title     String
  isRestDay Boolean @default(false)

  completedAt DateTime?

  exercises FitnessExercise[]

  @@unique([planId, dayIndex])
  @@index([date])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', plan.client.assignments?[staffId == auth().id && isActive])
  @@allow('read', plan.client.userId == auth().id)
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
  @@allow('create,update,delete', plan.client.assignments?[staffId == auth().id && isActive && role == fitness_trainer])
  // The owning client only marks the day done/undone — the program content is
  // the trainer's (mirrors RoadmapItem: tick, never rewrite).
  @@allow('update', plan.client.userId == auth().id)
  @@deny('update',
    plan.client.userId == auth().id && auth().role != founder && auth().role != ops_head &&
    (future().title != title || future().dayIndex != dayIndex || future().date != date ||
     future().isRestDay != isRestDay))
}

/// An exercise prescription within a workout day. Clients tick exercises off
/// (completedAt); the prescription itself is trainer-owned.
model FitnessExercise {
  id    String            @id @default(uuid()) @deny('update', true)
  dayId String            @deny('update', true)
  day   FitnessWorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  order       Int     @default(0)
  name        String
  sets        Int?
  reps        Int?
  durationSec Int?
  /// e.g. "Bodyweight", "Dumbbell", "Machine", "Cardio".
  equipment String?
  notes     String?

  completedAt DateTime?

  @@index([dayId])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', day.plan.client.assignments?[staffId == auth().id && isActive])
  @@allow('read', day.plan.client.userId == auth().id)
  @@allow('create,update,delete', auth().role == founder || auth().role == ops_head)
  @@allow('create,update,delete', day.plan.client.assignments?[staffId == auth().id && isActive && role == fitness_trainer])
  // Client tick-off only, never the prescription.
  @@allow('update', day.plan.client.userId == auth().id)
  @@deny('update',
    day.plan.client.userId == auth().id && auth().role != founder && auth().role != ops_head &&
    (future().name != name || future().order != order || future().sets != sets ||
     future().reps != reps || future().durationSec != durationSec ||
     future().equipment != equipment || future().notes != notes))
}

/// Weight time series (the Assessment's weightKg stays the one-time onboarding
/// snapshot; this is the tracked log behind the progress chart).
model WeightLog {
  id       String @id @default(uuid()) @deny('update', true)
  clientId String @deny('update', true)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  date     DateTime
  weightKg Float
  note     String?

  recordedById String @deny('update', true)
  recordedBy   User   @relation("WeightRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId, date])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  // Owner-client or assigned trainer log entries — always attributed to
  // themselves (SEC-6 class: no spoofed recorder).
  @@allow('create', auth().role == founder || auth().role == ops_head)
  @@allow('create', recordedById == auth().id && client.userId == auth().id)
  @@allow('create', recordedById == auth().id && client.assignments?[staffId == auth().id && isActive && role == fitness_trainer])
  // Corrections: admins anywhere, otherwise only one's own entries.
  @@allow('update,delete', auth().role == founder || auth().role == ops_head)
  @@allow('update,delete', recordedById == auth().id)
}

/// Body measurements time series (all cm; every field optional so partial
/// check-ins are fine).
model BodyMeasurement {
  id       String @id @default(uuid()) @deny('update', true)
  clientId String @deny('update', true)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  date    DateTime
  chestCm Float?
  waistCm Float?
  hipsCm  Float?
  bicepCm Float?
  thighCm Float?
  note    String?

  recordedById String @deny('update', true)
  recordedBy   User   @relation("MeasurementRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId, date])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id)
  @@allow('create', auth().role == founder || auth().role == ops_head)
  @@allow('create', recordedById == auth().id && client.userId == auth().id)
  @@allow('create', recordedById == auth().id && client.assignments?[staffId == auth().id && isActive && role == fitness_trainer])
  @@allow('update,delete', auth().role == founder || auth().role == ops_head)
  @@allow('update,delete', recordedById == auth().id)
}

/// Client-submitted weekly pulse on a plan (distinct from FollowUp's
/// weekly_checkin, which is a staff CRO call). One per plan-week.
model FitnessCheckIn {
  id     String      @id @default(uuid()) @deny('update', true)
  planId String      @deny('update', true)
  plan   FitnessPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// 1-based week of the plan (ceil(dayNumber / 7)).
  weekNumber  Int
  /// 1–5 self-rated energy/effort.
  energyLevel Int?
  weightKg    Float?
  note        String?
  /// The trainer's reply — trainer/admin-writable only.
  trainerComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, weekNumber])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', plan.client.assignments?[staffId == auth().id && isActive])
  @@allow('read', plan.client.userId == auth().id)
  @@allow('create,update', auth().role == founder || auth().role == ops_head)
  @@allow('create,update', plan.client.assignments?[staffId == auth().id && isActive && role == fitness_trainer])
  @@allow('create,update', plan.client.userId == auth().id)
  // The trainer reply is never client-written (nullable field, so the guard is
  // model-level on both create and update).
  @@deny('create', auth().role != founder && auth().role != ops_head && plan.client.userId == auth().id && trainerComment != null)
  @@deny('update', auth().role != founder && auth().role != ops_head && plan.client.userId == auth().id && future().trainerComment != trainerComment)
}

/// A trainer's dated note on a client. visibleToClient notes render in the
/// portal ("Trainer Notes"); internal ones stay staff-side (like
/// consultation_notes documents).
model TrainerNote {
  id       String @id @default(uuid()) @deny('update', true)
  clientId String @deny('update', true)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  authorId String @deny('update', true)
  author   User   @relation("TrainerNoteAuthor", fields: [authorId], references: [id])

  content         String
  visibleToClient Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])

  @@allow('read', auth().role == founder || auth().role == ops_head)
  @@allow('read', client.assignments?[staffId == auth().id && isActive])
  @@allow('read', client.userId == auth().id && visibleToClient)
  @@allow('create', auth().role == founder || auth().role == ops_head)
  @@allow('create', client.assignments?[staffId == auth().id && isActive && role == fitness_trainer])
  // Always authored as oneself (SEC-6 class: a spoofed author forges "the
  // founder said").
  @@deny('create', auth().role != founder && auth().role != ops_head && authorId != auth().id)
  @@allow('update,delete', auth().role == founder || auth().role == ops_head)
  @@allow('update,delete', authorId == auth().id)
}

// ============================================================================
// Notifications & audit
// ============================================================================

model Notification {
  id       String  @id @default(uuid()) @deny('update', true)
  // userId is immutable: re-pointing one's own notification at another user
  // plants a trusted, system-looking message in the victim's feed (phishing
  // primitive). Content fields are server-written and equally immutable.
  userId   String @deny('update', true)
  user     User    @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type     String @deny('update', true)
  title    String @deny('update', true)
  body     String?
  linkPath String?
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])

  // Notifications are created by the server (unenhanced client); users read and
  // mark their own as read. The only user-writable field is isRead — body and
  // linkPath are nullable, so their immutability guard is model-level.
  @@allow('read,update', userId == auth().id)
  @@deny('update', future().body != body || future().linkPath != linkPath)
  @@allow('delete', userId == auth().id)
}

model ActivityLog {
  id            String         @id @default(uuid())
  entityType    String
  entityId      String
  action        ActivityAction
  performedById String?
  performedBy   User?          @relation("ActivityActor", fields: [performedById], references: [id])
  summary       String?
  changes       Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])

  // Audit log is read-only to admins; written by the server (unenhanced).
  @@allow('read', auth().role == founder || auth().role == ops_head)
}
